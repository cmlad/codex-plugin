{
  "mcpServers": {
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "prometheus_example": {
      "command": "uv",
      "args": [
        "run",
        "/ABSOLUTE/PATH/TO/prometheus_mcp.py"
      ],
      "env": {
        "PROMETHEUS_URL": "${PROMETHEUS_URL}",
        "PROMETHEUS_USERNAME": "${PROMETHEUS_USERNAME}",
        "PROMETHEUS_PASSWORD": "${PROMETHEUS_PASSWORD}"
      }
    }
  }
}
